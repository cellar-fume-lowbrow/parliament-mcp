# --- Embeddings -------------------------------------------------------------
# Option A: local Ollama (default). Run: ollama pull qwen3-embedding:0.6b
# Ingest and query must use the identical model tag, or vectors won't match.
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_SEND_DIMENSIONS=false
# Applied to search queries only; changing it never requires re-embedding.
EMBEDDING_QUERY_TEMPLATE="Instruct: Given a search query, retrieve passages from UK Parliamentary debates and written questions that discuss it\nQuery:{query}"

# Option A2: OpenRouter (or any OpenAI-compatible endpoint)
# EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_API_KEY=sk-or-v1-XXX
# EMBEDDING_MODEL=baai/bge-m3
# EMBEDDING_QUERY_TEMPLATE=

# Option B: Azure OpenAI (upstream default) - set EMBEDDING_PROVIDER=azure
AZURE_OPENAI_API_KEY=XXX
AZURE_OPENAI_ENDPOINT=https://[[my-resource-name]].openai.azure.com/

# Optional parameters (The defaults are fine)

AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2025-03-01-preview

APP_NAME=parliament-mcp
AWS_REGION=aws-region
ENVIRONMENT=local
SENTRY_DSN=placeholder
DISABLE_AUTH_SIGNATURE_VERIFICATION=true

MCP_HOST=0.0.0.0
MCP_PORT=8080

# Qdrant Configuration
# Option 1: Local Qdrant
QDRANT_URL=http://localhost:6333

# Option 2: Qdrant Cloud (use instead of above)
# QDRANT_URL=https://your-cluster-url.qdrant.tech
# QDRANT_API_KEY=your-api-key-here
